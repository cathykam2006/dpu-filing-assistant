# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Cloud -> App settings -> Secrets. Never commit the real file.
# Every key is optional. With none, the app runs in no-AI mode.

GROQ_API_KEY = "gsk_..."            # free: console.groq.com/keys
# GEMINI_API_KEY = "..."            # free tier: aistudio.google.com/apikey (free-tier data may be used by Google)
# ANTHROPIC_API_KEY = "sk-ant-..."  # paid: console.anthropic.com

# DEFAULT_MODEL = "Groq · GPT-OSS 120B (free)"   # any label from the model list in rag/llm.py
# GROQ_MODEL = "openai/gpt-oss-120b"             # override if Groq renames or retires a model
# GEMINI_MODEL = "gemini-3.8-flash"

APP_PASSWORD = "choose-an-access-code"   # optional: remove to make the app open to anyone
MAX_QUESTIONS = 25                       # AI requests per browser session on your keys
